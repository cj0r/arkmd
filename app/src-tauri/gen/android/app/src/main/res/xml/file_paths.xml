<?xml version="1.0" encoding="utf-8"?>
<!-- ArkMD never opens the camera or a file chooser; the web view code generated by Tauri still names this provider for
     camera pictures, which it stores in the app's own pictures folder. Nothing else is shared. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-files-path name="pictures" path="Pictures/" />
</paths>
