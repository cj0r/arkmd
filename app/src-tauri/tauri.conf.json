{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkMD",
  "version": "0.34.0-3",
  "identifier": "app.arkmd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkMD",
        "width": 920,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http: asset:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lightweight Markdown viewer and editor",
    "longDescription": "Open a Markdown file and read it with Obsidian-style rendering and themes, then switch to a light editor with one tap.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/arkmd.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/arkmd.desktop"
      }
    },
    "createUpdaterArtifacts": true,
    "android": {
      "versionCode": 33903
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RjIzRjVFREU1MEJBQjIKUldTeXVsRGVYai95VjdmOFp4NDg5aDNCK0FjU1lCRE5zNXRLRVlTOTlpcElNSlRvZDJrWjUzWm8K",
      "endpoints": [
        "https://github.com/cj0r/arkmd/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
