{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkMD",
  "version": "0.5.1",
  "identifier": "app.arkmd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkMD",
        "width": 920,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 480,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http: asset:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lightweight Markdown viewer and editor",
    "longDescription": "Open a Markdown file and read it with Obsidian-style rendering and themes, then switch to a light editor with one tap.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/arkmd.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/arkmd.desktop"
      }
    }
  }
}
